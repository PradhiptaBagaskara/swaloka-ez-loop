{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Kemampuan default untuk jendela utama",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "dialog:default",
    "updater:default",
    "process:default",
    "opener:default",
    "opener:allow-reveal-item-in-dir",
    {
      "identifier": "opener:allow-open-path",
      "allow": [{ "path": "**" }]
    }
  ]
}
